{
  "expo": {
    "name": "CadNav 2",
    "slug": "cadnav2",
    "scheme": "cadnav",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icons/icon.png",
    "splash": {
      "image": "./assets/icons/CadNav.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EFE6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lyren.CadNav",
      "icon": "./assets/icons/CadNavIcon.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "api.maptiler.com": {
              "NSExceptionRequiresForwardSecrecy": false,
              "NSIncludesSubdomains": true
            },
            "maptiler.com": {
              "NSExceptionRequiresForwardSecrecy": false,
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "maplibre.org": {
              "NSExceptionRequiresForwardSecrecy": false,
              "NSIncludesSubdomains": true
            },
            "openstreetmap.org": {
              "NSExceptionRequiresForwardSecrecy": false,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "icon": "./assets/icons/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/foreground.png",
        "backgroundImage": "./assets/icons/background.png",
        "monochromeImage": "./assets/icons/monochromatic.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.lyren.CadNav",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icons/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "showMenuAtLaunch": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CadNav 2 to use your location for navigation and map positioning."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "assetBundlePatterns": [
      "assets/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1bd5eeec-a690-49b1-8350-988d778279bc"
      }
    },
    "owner": "lyren2"
  }
}
